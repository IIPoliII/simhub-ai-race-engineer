<Project Sdk="Microsoft.NET.Sdk">

  <!-- AIRaceEngineer-Setup.exe : choix de la langue, puis le MSI (embarqué). Construit par release.ps1 :
       dotnet build installer\Setup\Setup.csproj -c Release -p:Version=x.y.z -p:Msi=<AIRaceEngineer-Setup.msi> -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>AIRaceEngineer-Setup</AssemblyName>
    <RootNamespace>AIRaceEngineerSetup</RootNamespace>
    <LangVersion>latest</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>AI Race Engineer for SimHub</Product>
    <AssemblyTitle>AI Race Engineer Setup</AssemblyTitle>
    <Company>IIPoliII</Company>
    <Version>0.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup Condition="'$(Msi)' != ''">
    <EmbeddedResource Include="$(Msi)" LogicalName="setup.msi" />
  </ItemGroup>

</Project>
